  pivot_location {{"\[string map \{\"R\" \"input0.bbox.r\" \"C\" \"(input0.bbox.r- input0.bbox.x) / 2\" \"L\" \"input0.bbox.x\"\} \[value align_from_x]]"} {"\[string map \{\"U\" \"input0.bbox.t\" \"C\" \"(input0.bbox.t - input0.bbox.y) / 2\" \"L\" \"input0.bbox.y\"\} \[value align_from_y]]"}}
  addUserKnob {12 output_pos l "Output Position"}
  output_pos {{"\[string map \{\"R\" \"padded_box.r\" \"C\" \"(padded_box.r - padded_box.x) / 2 + padded_box.x\" \"L\" \"padded_box.x\"\} \[value align_to_x]] - pivot_location.x + relative_pos_px"} {"\[string map \{\"U\" \"padded_box.t\" \"C\" \"(padded_box.t - padded_box.y) / 2 + padded_box.y\" \"L\" \"padded_box.y\"\} \[value align_to_y]] - pivot_location.y + relative_pos_px"}}
