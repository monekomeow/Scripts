  addUserKnob {4 align_to_y l "Align To" M {U C L ""}}
  align_to_y L
  addUserKnob {4 align_to_x l "" -STARTLINE M {L C R}}
  align_to_x R
  addUserKnob {7 padding l "padding %"}
  padding 0.014
  addUserKnob {3 padding_px l "Padding Pixels"}
