  addUserKnob {12 relative_pos_px l "Relative Pos px" +INVISIBLE}
  relative_pos_px {{"align_size * relative_position"} {"align_size * relative_position"}}
  addUserKnob {7 relative_scale l "Relative Scale Size"}
  relative_scale 0.2
  addUserKnob {7 output_scale l "output scale"}
  output_scale {{"fit_axis == 0?align_size.w / input_size.w* relative_scale:align_size.h / (input_size.h) * relative_scale"}}
